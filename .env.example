# Copy this file to .env and change the passwords.
# .env is git-ignored. Never commit real secrets.

DB_NAME=portal
DB_USER=portal
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

WP_TABLE_PREFIX=wp_
WP_DEBUG=1

WP_PORT=8080
PMA_PORT=8081

# WordPress site setup (used by scripts/setup-base.sh)
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=CityCharcha
WP_ADMIN_USER=portaladmin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@portal.test
